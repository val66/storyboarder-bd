{
  "name": "storyboard-bd",
  "version": "1.10.7",
  "engines": {
    "node": ">=22"
  },
  "description": "Storyboarder BD — Découpage de planches BD",
  "main": "main.js",
  "author": "Valentin",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "test": "node --test tests/*.test.mjs",
    "lint": "eslint .",
    "bump": "node tools/bump-version.mjs",
    "bake-textures": "electron tools/bake-textures.mjs",
    "apercu-sol": "electron tools/apercu-sol.mjs",
    "setup-hooks": "node tools/setup-hooks.mjs",
    "typecheck": "tsc -p jsconfig.json --noEmit",
    "typecheck:report": "node tools/typecheck-report.mjs",
    "postinstall": "node tools/check-hooks.mjs",
    "cles-attestation": "node tools/cles-attestation.mjs",
    "obligatoire": "node tools/obligatoire.mjs"
  },
  "dependencies": {
    "three": "0.128.0"
  },
  "devDependencies": {
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "com.valentin.storyboardbd",
    "productName": "Storyboarder BD",
    "files": [
      "main.js",
      "preload.js",
      "window-state.js",
      "projects-dir.js",
      "store.js",
      "store-sketchfab.js",
      "store-sources.js",
      "update-policy.js",
      "updater.js",
      "attestation-cle.js",
      "preload-blocage.js",
      "blocage.html",
      "index.html",
      "style.css",
      "assets/**/*",
      "!assets/textures/sources/**",
      "package.json",
      "src/**/*",
      "node_modules/three/build/three.min.js"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Storyboarder BD",
      "artifactName": "Storyboarder-BD-Setup-${version}.${ext}"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "publish": {
      "provider": "github",
      "owner": "val66",
      "repo": "storyboarder-bd"
    }
  }
}
